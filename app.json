{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "owner": "kingerko",
    "version": "1.1.0",
    "scheme": "lumen",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0E",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.martinbalaz.lumen",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lumen saves where you write each new entry so you can find it on the map. You can change or turn this off anytime.",
        "NSPhotoLibraryUsageDescription": "Lumen adds the photos and videos you choose to your entry.",
        "NSCameraUsageDescription": "Lumen uses the camera so you can take a photo straight into your entry.",
        "NSFaceIDUsageDescription": "Unlock Lumen with Face ID instead of your passcode.",
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.martinbalaz.lumen",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withSceneLifecycle",
      "expo-router",
      "expo-image",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lumen saves where you write each new entry so you can find it on the map. You can change or turn this off anytime."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumen adds the photos and videos you choose to your entry.",
          "cameraPermission": "Lumen uses the camera so you can take a photo straight into your entry.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-asset",
      "expo-localization",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f9284bb5-9528-4af5-b82a-d047417ae24d"
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "sk": "./locales/sk.json"
    }
  }
}
