{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "owner": "kingerko",
    "version": "1.1.0",
    "scheme": "lumen",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0E",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.martinbalaz.lumen",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lumen si pri novom zápisku automaticky uloží miesto, kde si ho napísal, aby si ho neskôr našiel na mape.",
        "NSPhotoLibraryUsageDescription": "Lumen potrebuje prístup k fotkám, aby si k zápiskom mohol priradiť obrázky.",
        "NSCameraUsageDescription": "Lumen potrebuje prístup ku kamere, aby si mohol odfotiť moment priamo do zápisku.",
        "NSFaceIDUsageDescription": "Odomkni Lumen pomocou Face ID namiesto PIN kódu.",
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.martinbalaz.lumen",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_BIOMETRIC"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lumen si pri novom zápisku automaticky uloží miesto, kde si ho napísal."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumen potrebuje prístup k fotkám, aby si k zápiskom mohol priradiť obrázky.",
          "cameraPermission": "Lumen potrebuje prístup ku kamere, aby si mohol odfotiť moment priamo do zápisku.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f9284bb5-9528-4af5-b82a-d047417ae24d"
      }
    }
  }
}
