# ---------------------------------------------------------------------------
# Lumen — konfigurácia MOBILNEJ APPKY
#
# Skopíruj do .env:   cp .env.example .env
# Po zmene reštartuj Metro s vyčistenou cache:   npx expo start --clear
#
# ⚠️  SEM NEPATRIA ŽIADNE TAJNÉ KĽÚČE.
# Expo zabalí každú EXPO_PUBLIC_* premennú priamo do JS bundle. Ktokoľvek si
# vie rozbaliť .ipa / .apk a prečítať ju. R2 Access Key ID a Secret Access Key
# preto idú výhradne na server — pozri ~/www/laravel_projects/lumen-api/.env.example
# ---------------------------------------------------------------------------

# URL nášho Laravel API (nasadené cez Coolify). Appka komunikuje len s ním.
EXPO_PUBLIC_API_URL=https://lumen-api.tvoja-domena.sk

# Voliteľné: verejná doména R2 bucketu, ak by bol bucket verejný.
# Pre súkromný denník nechaj prázdne — fotky sa načítavajú cez presigned URL.
EXPO_PUBLIC_MEDIA_BASE_URL=
